generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model Appointment {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  location    String?
  description String?
  userId      String?
  createdAt   DateTime @default(now())
}
